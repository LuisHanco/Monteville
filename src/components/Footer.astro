---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contacto, legal, links, nav } from '../data/arko';

const year = new Date().getFullYear();
---

<footer class="px-4 pt-24 pb-12 md:px-12 xl:px-24">
  <div class="grid gap-12 md:grid-cols-2 xl:grid-cols-4">
    <div class="flex flex-col gap-4">
      <Logo class="text-xl self-start text-crema" />
      
      <!-- Eslogan corporativo agregado aquí -->
      <p class="text-xs font-medium tracking-widest text-teja uppercase mt-1">
        Contribuimos con tu Éxito
      </p>

      <p class="max-w-xs text-sm text-crema/70">
        Alta heladería gourmet en Cusco, exclusiva para cafeterías, hoteles y restaurantes de alto prestigio.
      </p>
      <nav aria-label="Secciones" class="mt-2">
        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={`/${item.href}`} class="link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-2 text-sm">
      <h2 class="font-sans text-xs tracking-widest text-crema/50 uppercase">Cobertura</h2>
      <address class="not-italic">{contacto.calle}<br />{contacto.barrio}</address>
      <a href={links.maps} class="link inline-flex items-center gap-2 self-start mt-1" rel="noopener" target="_blank">
        <Icon name="mapPin" />
        Ver ubicación
      </a>
    </div>

    <div class="flex flex-col gap-2 text-sm">
      <h2 class="font-sans text-xs tracking-widest text-crema/50 uppercase">Atención B2B</h2>
      <p>{contacto.horario}</p>
      <p class="text-crema/70">{contacto.cocina}</p>
    </div>

    <div class="flex flex-col gap-2 text-sm">
      <h2 class="font-sans text-xs tracking-widest text-crema/50 uppercase">Contacto comercial</h2>
      <a href={links.telefono} class="link inline-flex items-center gap-2 self-start mt-1">
        <Icon name="phone" />
        {contacto.telefono}
      </a>
      <a href={links.email} class="link inline-flex items-center gap-2 self-start mt-1">
        <Icon name="envelope" />
        {contacto.email}
      </a>
      <a href={links.instagram} class="link inline-flex items-center gap-2 self-start mt-1" rel="noopener" target="_blank">
        <Icon name="instagram" />
        {contacto.instagram}
      </a>
    </div>
  </div>

  <div class="mt-16 flex flex-col gap-4 border-t border-crema/10 pt-8 text-xs text-crema/50 md:flex-row md:items-center md:justify-between">
    <p>© {year} Monteville. Todos los derechos reservados.</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        legal.map((item) => (
          <li>
            <a href={item.href} class="link hover:text-crema transition-colors" rel="noopener">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>