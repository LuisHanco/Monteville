---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { links, photos } from '../data/arko';
---

<Layout title="Página no encontrada · Monteville" description="Esta página no existe." noindex header={false}>
  <section class="flex min-h-svh flex-col items-center justify-center gap-12 px-4 py-24 text-center md:flex-row md:text-left">
    <div data-reveal class="w-48 md:w-64">
      <Picture
        src={photos.vinos}
        alt="Monteville, alta heladería gourmet en Cusco"
        formats={['avif', 'webp']}
        widths={[320, 512]}
        sizes="256px"
        loading="eager"
        pictureAttributes={{ class: 'block' }}
        class="aspect-[9/16] w-full mask-arch object-cover"
      />
    </div>
    <div class="flex max-w-md flex-col items-center gap-6 md:items-start">
      <a href="/" aria-label="Monteville, volver al inicio" class="text-crema">
        <Logo class="text-lg" />
      </a>
      <p data-reveal class="text-sm text-teja">Error 404</p>
      <h1 data-reveal style="--d:100ms" class="text-4xl lg:text-5xl">Esta página no existe</h1>
      <p data-reveal style="--d:200ms" class="text-base text-crema/70">
        La ruta que buscas ha cambiado o no está disponible. Puedes volver al inicio o explorar nuestra carta de sabores.
      </p>
      <div data-reveal style="--d:300ms" class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="btn btn-ghost"><Icon name="arrowLeft" class="size-5" /><span>Volver al inicio</span></a>
        <a href="/carta" class="btn btn-primary"><span>Ver carta</span></a>
      </div>
    </div>
  </section>
</Layout>