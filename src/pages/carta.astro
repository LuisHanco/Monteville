---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import Spiral from '../components/Spiral.astro';
import { contacto, links, photos } from '../data/arko';

type Filtro = 'vegano' | 'sin-frutos-secos' | 'cafeteria' | 'alta-cocina';

type Sabor = {
  nombre: string;
  notas: string;
  maridaje: string;
  alergenos: string[];
  filtros: Filtro[];
  imagen: ImageMetadata;
  etiqueta?: string;
};

type Categoria = {
  id: string;
  numero: string;
  titulo: string;
  subtitulo: string;
  sabores: Sabor[];
};

const categorias: Categoria[] = [
  {
    id: 'clasicos',
    numero: '01',
    titulo: 'Clásicos & Tradición',
    subtitulo: 'Recetas de toda la vida ejecutadas con maestría, texturas ricas e ingredientes seleccionados.',
    sabores: [
      {
        nombre: 'Chocolate Intenso',
        notas: 'Cacao oscuro de origen con trozos de brownie artesanal y un sedoso fudge de chocolate. Una experiencia profunda y envolvente.',
        maridaje: 'Ideal para acompañar con un espresso doble o coronar postres de frutos rojos frescos.',
        alergenos: ['Lácteos', 'Gluten'],
        filtros: ['cafeteria', 'alta-cocina'],
        imagen: photos.chocolate,
        etiqueta: 'Insignia',
      },
      {
        nombre: 'Vainilla',
        notas: 'Crema aterciopelada infusionada con auténtica vaina de vainilla, coronada con un crujiente barquillo tradicional.',
        maridaje: 'El acompañante definitivo para affogatos, crumbles de manzana y tartas tibias.',
        alergenos: ['Lácteos', 'Gluten'],
        filtros: ['sin-frutos-secos', 'cafeteria', 'alta-cocina'],
        imagen: photos.vainilla,
        etiqueta: 'Ideal affogato',
      },
      {
        nombre: 'Caramelo',
        notas: 'Helado cremoso bañado en una rica salsa dorada de caramelo artesanal y nueces tostadas para un contraste crujiente.',
        maridaje: 'Perfecto en copas heladas de autor y acompañando repostería hojaldrada o pera asada.',
        alergenos: ['Lácteos', 'Frutos secos'],
        filtros: ['cafeteria'],
        imagen: photos.caramelo,
      },
      {
        nombre: 'Ron con Pasas',
        notas: 'Un clásico madurado, de notas cálidas, con abundantes pasas oscuras finamente maceradas en ron añejo.',
        maridaje: 'Excelente cierre de sobremesa para cenas de gala o maridado con licores oscuros.',
        alergenos: ['Lácteos', 'Alcohol'],
        filtros: ['sin-frutos-secos', 'alta-cocina'],
        imagen: photos.ronConPasas,
        etiqueta: 'Clásico',
      },
      {
        nombre: 'Menta',
        notas: 'Refrescante crema de menta natural, verde vibrante, salpicada con crujientes chispas de chocolate amargo.',
        maridaje: 'El contraste perfecto y limpiador para postres densos a base de cacao oscuro.',
        alergenos: ['Lácteos'],
        filtros: ['cafeteria'],
        imagen: photos.menta,
      },
    ],
  },
  {
    id: 'frutas',
    numero: '02',
    titulo: 'Frutas & Sorbetes',
    subtitulo: 'Selección refrescante con alto porcentaje de pulpa natural, ideales como prepostre.',
    sabores: [
      {
        nombre: 'Maracuyá',
        notas: 'Sorbete vibrante elaborado con pulpa fresca, salsa natural y semillas crujientes que realzan su acidez tropical.',
        maridaje: 'Limpia el paladar y aporta frescura vibrante en menús degustación de varios tiempos.',
        alergenos: ['Sin lácteos', 'Sin gluten'],
        filtros: ['vegano', 'sin-frutos-secos', 'alta-cocina'],
        imagen: photos.maracuya,
        etiqueta: 'Vegano',
      },
      {
        nombre: 'Frutos del Bosque',
        notas: 'Intensa fusión de tonos rojos a base de moras, frambuesas y arándanos silvestres. Puro sabor frutal.',
        maridaje: 'Diseñado para maridar excepcionalmente con espumantes, chocolate blanco y repostería fina.',
        alergenos: ['Sin lácteos', 'Sin gluten'],
        filtros: ['vegano', 'sin-frutos-secos', 'alta-cocina'],
        imagen: photos.frutosDelBosque,
        etiqueta: 'Vegano',
      },
      {
        nombre: 'Durazno',
        notas: 'Delicada base cremosa y frutal acompañada de tiernos gajos de durazno conservados en su almíbar natural.',
        maridaje: 'Armoniza maravillosamente con postres de vainilla, almendras tostadas y copas de verano.',
        alergenos: ['Lácteos'],
        filtros: ['sin-frutos-secos', 'cafeteria'],
        imagen: photos.durazno,
      },
      {
        nombre: 'Naranja',
        notas: 'Sorbete cítrico y refrescante, texturizado con sutiles ralladuras y un toque visual de rodaja confitada.',
        maridaje: 'Ligero y digestivo, ideal para refrescar el paladar en almuerzos ejecutivos y terrazas al sol.',
        alergenos: ['Sin lácteos', 'Sin gluten'],
        filtros: ['vegano', 'sin-frutos-secos', 'cafeteria'],
        imagen: photos.naranja,
        etiqueta: 'Vegano',
      },
      {
        nombre: 'Coco',
        notas: 'Cremosidad tropical en color blanco puro, enriquecida con abundante coco rallado y trozos de fruta natural.',
        maridaje: 'Base versátil para postres exóticos, bizcochos húmedos y coctelería de autor.',
        alergenos: ['Lácteos'],
        filtros: ['sin-frutos-secos', 'alta-cocina'],
        imagen: photos.coco,
      },
    ],
  },
  {
    id: 'postres',
    numero: '03',
    titulo: 'Postres de Autor & Especialidades',
    subtitulo: 'Sabores complejos inspirados en la repostería y los postres más queridos.',
    sabores: [
      {
        nombre: 'Lúcuma',
        notas: 'El oro de los Andes en su máxima expresión. Helado ocre natural con un elegante copete y un sutil hilo de salsa de chocolate o dulce de leche.',
        maridaje: 'El protagonista indiscutible en la carta de postres peruanos contemporáneos.',
        alergenos: ['Lácteos'],
        filtros: ['sin-frutos-secos', 'alta-cocina'],
        imagen: photos.lucuma,
        etiqueta: 'Más pedido',
      },
      {
        nombre: 'Pay de Limón',
        notas: 'La deconstrucción del clásico: crema de limón amarillo suave, coronada con merengue tostado a soplete y crujientes trozos de galleta.',
        maridaje: 'Ideal para vitrinas boutique, servicio en copa y paladares que buscan equilibrio dulce-ácido.',
        alergenos: ['Lácteos', 'Gluten'],
        filtros: ['cafeteria'],
        imagen: photos.payDeLimon,
      },
      {
        nombre: 'Capuchino',
        notas: 'Equilibrio perfecto de café de especialidad y crema láctea, decorado con granos enteros tostados y fino polvo de cacao.',
        maridaje: 'El complemento perfecto para pastelería seca, galletas de mantequilla y largas sobremesas.',
        alergenos: ['Lácteos'],
        filtros: ['sin-frutos-secos', 'cafeteria'],
        imagen: photos.capuchino,
      },
      {
        nombre: 'Banana con Chicle',
        notas: 'Divertido y nostálgico remolino en vibrantes tonos amarillo, rosa y azul, decorado con alegres chispas de colores.',
        maridaje: 'El favorito indiscutible en menús infantiles y copas heladas creativas llenas de magia.',
        alergenos: ['Lácteos'],
        filtros: ['sin-frutos-secos', 'cafeteria'],
        imagen: photos.bananaConChicle,
        etiqueta: 'Infantil',
      },
    ],
  },
];

const filtrosUI = [
  { id: 'todos', label: 'Todos los sabores' },
  { id: 'cafeteria', label: 'Ideal cafetería' },
  { id: 'alta-cocina', label: 'Alta cocina' },
  { id: 'vegano', label: 'Vegano / Sin lácteos' },
  { id: 'sin-frutos-secos', label: 'Sin frutos secos' },
];

const formatos = [
  {
    titulo: 'Cubeta 2.5 L',
    uso: 'Cafeterías & Vitrina Boutique',
    detalle: 'Rotación ágil, ideal para affogatos, copas de autor y cartas de postres dinámicas.',
    rinde: 'Aprox. 30 a 35 bolas (70 g)',
    precio: 'Desde S/ 120',
  },
  {
    titulo: 'Cubeta 5 L',
    uso: 'Hoteles, Restaurantes & Banquetes',
    detalle: 'Máximo rendimiento en cocina y room service con estabilidad térmica controlada.',
    rinde: 'Aprox. 65 a 70 bolas (70 g)',
    precio: 'Desde S/ 220',
  },
  {
    titulo: 'Desarrollo de Autor',
    uso: 'Recetas Exclusivas',
    detalle: 'Formulamos helados o sorbetes a medida junto a tu chef ejecutivo o jefe de barra.',
    rinde: 'Lote mínimo coordinado',
    precio: 'Desde S/ 250',
  },
];

const fichaTecnica = [
  { etiqueta: 'Conservación', valor: '-18 °C', detalle: 'Almacenamiento en congelador horizontal o vertical' },
  { etiqueta: 'Servicio óptimo', valor: '-12 °C a -14 °C', detalle: 'Textura cremosa lista para quenelle o boleo' },
  { etiqueta: 'Despacho', valor: 'Cadena de frío', detalle: 'Entregas programadas en Cusco y Valle Sagrado' },
  { etiqueta: 'Elaboración', valor: 'Lotes frescos', detalle: 'Sin colorantes artificiales ni bases industriales' },
];
---

<Layout
  title="Carta de Sabores · Monteville Helados Gourmet"
  description="Catálogo exclusivo HoReCa de Monteville en Cusco: sabores de origen andino, clásicos de alta heladería, sorbetes naturales, alérgenos y formatos profesionales."
  header={false}
>
  <!-- Barra superior -->
  <header class="sticky top-0 z-50 border-b border-crema/10 bg-bg/85 px-4 py-4 backdrop-blur-xl print:hidden md:px-12 xl:px-24">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
      <a href="/" class="link inline-flex items-center gap-2 text-sm text-crema/80 hover:text-crema">
        <Icon name="arrowLeft" class="size-4" />
        <span class="hidden sm:inline">Volver al inicio</span>
      </a>

      <a href="/" aria-label="Monteville, ir al inicio" class="text-crema">
        <Logo class="text-base" />
      </a>

      <div class="flex items-center gap-2">
        <button
          type="button"
          data-print-btn
          class="hidden rounded-full px-3.5 py-2 text-xs text-crema/75 ring-1 ring-crema/15 transition-colors hover:bg-crema/10 hover:text-crema sm:inline-flex"
        >
          Imprimir / PDF
        </button>
        <a href={links.reservar} rel="noopener" target="_blank" class="btn btn-primary btn-sm px-4">
          <span>Degustación</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Portada de la carta -->
  <section class="relative overflow-hidden px-4 pt-16 pb-12 md:px-12 md:pt-20 xl:px-24">
    <Spiral
      rings={12}
      class="pointer-events-none absolute top-0 right-0 w-[520px] translate-x-1/3 -translate-y-1/4 text-crema/10 print:hidden"
    />
    <div class="relative mx-auto max-w-6xl">
      <p data-reveal class="text-xs font-medium tracking-widest text-teja uppercase">
        Contribuimos con tu Éxito · Catálogo Exclusivo HoReCa
      </p>
      <h1 data-reveal style="--d:100ms" class="mt-4 max-w-3xl text-4xl lg:text-6xl font-display">
        Carta de Sabores
      </h1>
      <p data-reveal style="--d:200ms" class="mt-6 max-w-2xl text-base text-crema/75 lg:text-lg">
        Alta heladería artesanal formulada para cocina, barra de café y servicio en mesa. Selecciona los sabores que te
        interesen para armar tu solicitud de degustación privada.
      </p>

      <!-- Barra de filtros interactivos -->
      <div data-reveal style="--d:280ms" class="mt-10 flex flex-col gap-4 print:hidden">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar sabores">
          {
            filtrosUI.map((f, idx) => (
              <button
                type="button"
                data-filter={f.id}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'filter-btn rounded-full px-4 py-2 text-xs transition-all ring-1',
                  idx === 0
                    ? 'bg-teja text-bg ring-teja font-medium shadow-md'
                    : 'bg-crema/[0.04] text-crema/80 ring-crema/15 hover:bg-crema/10 hover:text-crema',
                ]}
              >
                {f.label}
              </button>
            ))
          }
        </div>

        <!-- Accesos rápidos a secciones -->
        <nav aria-label="Ir a categoría" class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-crema/60 mt-2">
          {
            categorias.map((cat) => (
              <a href={`#${cat.id}`} class="link inline-flex items-center gap-1.5 hover:text-crema transition-colors">
                <span class="font-display text-teja">{cat.numero}</span>
                <span>{cat.titulo}</span>
              </a>
            ))
          }
          <a href="#formatos" class="link inline-flex items-center gap-1.5 hover:text-crema transition-colors">
            <span class="font-display text-teja">04</span>
            <span>Formatos y Ficha Técnica</span>
          </a>
        </nav>
      </div>
    </div>
  </section>

  <!-- Listado de categorías y sabores -->
  <div class="px-4 pb-32 md:px-12 xl:px-24">
    <div class="mx-auto flex max-w-6xl flex-col gap-20">
      {
        categorias.map((cat) => (
          <section id={cat.id} data-category aria-labelledby={`titulo-${cat.id}`} class="scroll-mt-28">
            <div class="flex flex-col gap-3 border-b border-crema/15 pb-6 md:flex-row md:items-end md:justify-between">
              <div>
                <p data-reveal class="font-display text-sm text-teja">{cat.numero}</p>
                <h2 id={`titulo-${cat.id}`} data-reveal style="--d:80ms" class="mt-2 text-3xl lg:text-4xl font-display">
                  {cat.titulo}
                </h2>
              </div>
              <p data-reveal style="--d:140ms" class="max-w-md text-sm text-crema/70">
                {cat.subtitulo}
              </p>
            </div>

            <ol class="divide-y divide-transparent">
              {cat.sabores.map((sabor, i) => (
                <li
                  data-reveal
                  data-flavor-item
                  data-tags={sabor.filtros.join(',')}
                  style={`--d:${i * 50}ms`}
                  class="group grid grid-cols-[1fr_auto] items-center gap-6 py-8 md:gap-10 hover:bg-crema/[0.03] transition-colors duration-300 rounded-3xl px-4 -mx-4 border border-transparent hover:border-crema/5"
                >
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-3">
                      <h3 class="text-xl lg:text-2xl font-medium">{sabor.nombre}</h3>
                      {sabor.etiqueta && (
                        <span class="rounded-full bg-teja/15 px-3 py-0.5 text-xs text-teja ring-1 ring-teja/30 font-medium">
                          {sabor.etiqueta}
                        </span>
                      )}
                    </div>

                    <p class="mt-3 max-w-2xl text-sm text-crema/80 lg:text-base leading-relaxed">{sabor.notas}</p>
                    <p class="mt-2 text-xs text-crema/55 italic">{sabor.maridaje}</p>

                    <div class="mt-5 flex flex-wrap items-center gap-4">
                      <div class="flex flex-wrap gap-2">
                        {sabor.alergenos.map((alergeno) => (
                          <span class="rounded-full bg-crema/[0.05] px-3 py-1 text-[11px] text-crema/70 ring-1 ring-crema/10 uppercase tracking-wider">
                            {alergeno}
                          </span>
                        ))}
                      </div>

                      <button
                        type="button"
                        data-select-flavor={sabor.nombre}
                        aria-pressed="false"
                        class="flavor-pick inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-xs text-crema/80 ring-1 ring-crema/20 transition-all hover:border-teja hover:text-crema print:hidden hover:shadow-sm"
                      >
                        <Icon name="plus" class="size-3.5 text-teja" />
                        <span data-pick-label>Probar en cata</span>
                      </button>
                    </div>
                  </div>

                  <!-- Botón de imagen (Abre el modal al clickear, sin perder nitidez al hacer hover) -->
                  <button
                    type="button" 
                    title="Ver detalle"
                    class="relative shrink-0 w-28 md:w-36 transition-all duration-500 group-hover:scale-105 group-hover:-translate-y-1 focus:outline-none"
                    data-modal-trigger
                    data-nombre={sabor.nombre}
                    data-notas={sabor.notas}
                    data-maridaje={sabor.maridaje}
                    data-imagen={sabor.imagen.src}
                  >
                    <!-- Resplandor vibrante de fondo -->
                    <div class="absolute inset-0 bg-teja/25 blur-2xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none z-0"></div>
                    
                    <!-- Contenedor BLOB de la foto (Sin filtros que laven la imagen) -->
                    <div class="shape-blob relative z-10 overflow-hidden shadow-lg aspect-square md:aspect-[4/4.2] border border-crema/10 group-hover:border-teja/50 transition-colors duration-500">
                      <Picture
                        src={sabor.imagen}
                        alt={sabor.nombre}
                        formats={['avif', 'webp']}
                        widths={[160, 320, 640]}
                        sizes="(min-width: 768px) 144px, 112px"
                        loading="lazy"
                        decoding="async"
                        pictureAttributes={{ class: 'block h-full w-full' }}
                        class="h-full w-full object-cover transition-all duration-700 group-hover:scale-110 group-hover:rotate-2"
                      />
                    </div>
                  </button>
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <!-- Sección de Formatos y Ficha Técnica -->
      <section id="formatos" aria-labelledby="titulo-formatos" class="scroll-mt-28">
        <div class="max-w-xl">
          <p data-reveal class="font-display text-sm text-teja">04</p>
          <h2 id="titulo-formatos" data-reveal style="--d:80ms" class="mt-2 text-3xl lg:text-4xl font-display">
            Formatos y Ficha Técnica HoReCa
          </h2>
          <p data-reveal style="--d:140ms" class="mt-4 text-sm text-crema/70 lg:text-base">
            Presentaciones estandarizadas para control de costos, porcionado consistente y operación continua en cocina.
          </p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {
            formatos.map((formato, i) => (
              <article
                data-reveal
                style={`--d:${i * 90}ms`}
                class="flex flex-col justify-between rounded-3xl p-6 ring-1 ring-crema/15 lg:p-8 bg-gradient-to-b from-transparent to-crema/[0.02] hover:ring-crema/30 transition-all"
              >
                <div>
                  <p class="text-xs tracking-widest text-teja uppercase font-semibold">{formato.uso}</p>
                  <h3 class="mt-3 text-2xl font-medium">{formato.titulo}</h3>
                  <p class="mt-3 text-sm text-crema/70">{formato.detalle}</p>
                </div>
                <div class="mt-6 border-t border-crema/10 pt-4">
                  <p class="font-display text-2xl text-crema">{formato.precio}</p>
                  <p class="mt-1 text-xs text-crema/60">{formato.rinde}</p>
                </div>
              </article>
            ))
          }
        </div>

        <!-- Ficha técnica resumida -->
        <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            fichaTecnica.map((dato) => (
              <div class="rounded-2xl bg-crema/[0.03] p-5 ring-1 ring-crema/10 hover:bg-crema/[0.05] transition-colors">
                <dt class="text-xs tracking-widest text-teja uppercase">{dato.etiqueta}</dt>
                <dd class="font-display mt-2 text-2xl text-crema">{dato.valor}</dd>
                <p class="mt-1 text-xs text-crema/60">{dato.detalle}</p>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- CTA de cierre -->
      <section
        data-reveal
        class="flex flex-col items-start justify-between gap-8 rounded-3xl bg-crema/[0.03] p-8 ring-1 ring-crema/15 md:flex-row md:items-center lg:p-12 print:hidden relative overflow-hidden"
      >
        <div class="absolute inset-0 bg-gradient-to-r from-teja/5 to-transparent pointer-events-none"></div>
        <div class="max-w-xl relative z-10">
          <p class="text-xs font-medium tracking-widest text-teja uppercase">Contribuimos con tu Éxito</p>
          <h2 class="mt-3 text-2xl lg:text-4xl font-display">¿Quieres probar nuestra carta en tu cocina?</h2>
          <p class="mt-3 text-sm text-crema/70 lg:text-base">
            Agenda una degustación privada sin costo o solicita nuestro tarifario preferencial por volumen para tu
            establecimiento.
          </p>
        </div>

        <div class="flex flex-col items-start gap-3 md:items-end relative z-10">
          <a href={links.reservar} rel="noopener" target="_blank" class="btn btn-primary shadow-lg shadow-teja/20 hover:shadow-teja/40 transition-shadow">
            <span>Agendar degustación</span>
            <Icon name="arrowUpRight" class="size-4" />
          </a>
          <a href={links.telefono} class="link inline-flex items-center gap-2 text-sm text-crema/70 hover:text-crema transition-colors">
            <Icon name="phone" class="size-4" />
            <span>{contacto.telefono}</span>
          </a>
        </div>
      </section>
    </div>
  </div>

  <!-- Barra flotante de selección de cata -->
  <aside
    id="tasting-bar"
    hidden
    aria-live="polite"
    class="fixed inset-x-4 bottom-5 z-50 mx-auto max-w-2xl rounded-full bg-bg/95 px-5 py-3 shadow-2xl ring-1 ring-teja/50 backdrop-blur-xl print:hidden"
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3 text-sm">
        <span
          id="tasting-count"
          class="grid size-7 place-items-center rounded-full bg-teja font-medium text-bg tabular-nums"
        >
          0
        </span>
        <span class="text-crema">
          <span id="tasting-text">sabores para degustación</span>
        </span>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="tasting-clear"
          class="rounded-full px-3 py-1.5 text-xs text-crema/60 transition-colors hover:text-crema"
        >
          Limpiar
        </button>
        <a
          id="tasting-send"
          href={links.reservar}
          rel="noopener"
          target="_blank"
          class="btn btn-primary btn-sm px-4 shadow-sm"
        >
          <span>Pedir cata por WhatsApp</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- MODAL DE VISUALIZACIÓN DEL HELADO -->
  <dialog id="flavor-modal" class="backdrop:bg-bg/90 backdrop:backdrop-blur-md bg-transparent p-4 w-full max-w-lg m-auto rounded-3xl shadow-2xl">
    <div class="bg-bg border border-crema/15 rounded-3xl p-6 md:p-10 relative overflow-hidden flex flex-col items-center text-center">
      <!-- Botón de cerrar modal -->
      <button type="button" id="close-modal" class="absolute top-4 right-4 text-crema/60 hover:text-crema bg-crema/5 hover:bg-crema/10 p-2 rounded-full transition-colors focus:outline-none">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      
      <!-- Foto del helado en BLOB gigante -->
      <div class="shape-blob relative z-10 w-48 h-48 md:w-64 md:h-64 mb-6 shadow-2xl overflow-hidden border-2 border-crema/10">
         <img id="modal-img" src="" alt="Sabor de Helado" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" />
      </div>
      
      <!-- Información -->
      <h3 id="modal-title" class="text-3xl font-display text-crema font-medium"></h3>
      <p id="modal-notes" class="mt-4 text-crema/80 leading-relaxed"></p>
      <p id="modal-pairing" class="mt-3 text-sm text-teja italic"></p>
    </div>
  </dialog>
</Layout>

<style>
  .flavor-pick[aria-pressed='true'] {
    background-color: color-mix(in oklab, var(--color-teja) 20%, transparent);
    color: var(--color-crema);
    --tw-ring-color: var(--color-teja);
  }

  /* Animación CSS para la forma orgánica (Blob) */
  .shape-blob {
    border-radius: 50% 50% 40% 60% / 60% 40% 60% 40%;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* El hover hace que el blob se mueva fluidamente */
  .group:hover .shape-blob,
  #flavor-modal .shape-blob {
    border-radius: 40% 60% 60% 40% / 40% 60% 40% 60%;
  }

  /* Animación emergente del modal */
  dialog[open] {
    animation: modal-pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  dialog::backdrop {
    animation: fade-in 0.3s ease-out forwards;
  }
  @keyframes modal-pop {
    from { opacity: 0; transform: scale(0.95) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  // 1. Imprimir / Guardar como PDF
  document.querySelector('[data-print-btn]')?.addEventListener('click', () => window.print());

  // 2. Filtros interactivos de sabores
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const flavorItems = [...document.querySelectorAll<HTMLElement>('[data-flavor-item]')];
  const categories = [...document.querySelectorAll<HTMLElement>('[data-category]')];

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filter || 'todos';

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-teja', active);
        b.classList.toggle('text-bg', active);
        b.classList.toggle('ring-teja', active);
        b.classList.toggle('font-medium', active);
        b.classList.toggle('shadow-md', active);
        b.classList.toggle('bg-crema/[0.04]', !active);
        b.classList.toggle('text-crema/80', !active);
        b.classList.toggle('ring-crema/15', !active);
      });

      flavorItems.forEach((item) => {
        const tags = (item.dataset.tags || '').split(',');
        const show = selected === 'todos' || tags.includes(selected);
        item.hidden = !show;
      });

      categories.forEach((cat) => {
        const hasVisible = cat.querySelector('[data-flavor-item]:not([hidden])') !== null;
        cat.hidden = !hasVisible;
      });
    });
  });

  // 3. Lógica del Modal Interactivo
  const modal = document.getElementById('flavor-modal') as HTMLDialogElement;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalNotes = document.getElementById('modal-notes');
  const modalPairing = document.getElementById('modal-pairing');
  const closeModal = document.getElementById('close-modal');
  const modalTriggers = document.querySelectorAll<HTMLButtonElement>('[data-modal-trigger]');

  modalTriggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      if (modalImg && modalTitle && modalNotes && modalPairing) {
        modalImg.src = trigger.dataset.imagen || '';
        modalTitle.textContent = trigger.dataset.nombre || '';
        modalNotes.textContent = trigger.dataset.notas || '';
        modalPairing.textContent = trigger.dataset.maridaje || '';
        modal.showModal();
      }
    });
  });

  // Cerrar el modal con el botón 'x'
  closeModal?.addEventListener('click', () => modal.close());

  // Cerrar el modal haciendo clic fuera de la caja
  modal?.addEventListener('click', (e) => {
    const rect = modal.getBoundingClientRect();
    const isOutside = e.clientY < rect.top || e.clientY > rect.bottom || e.clientX < rect.left || e.clientX > rect.right;
    if (isOutside) {
      modal.close();
    }
  });

  // 4. Selector interactivo de degustación por WhatsApp
  const selectedFlavors = new Set<string>();
  const pickBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-select-flavor]')];
  const bar = document.getElementById('tasting-bar');
  const countEl = document.getElementById('tasting-count');
  const textEl = document.getElementById('tasting-text');
  const sendLink = document.getElementById('tasting-send') as HTMLAnchorElement | null;
  const clearBtn = document.getElementById('tasting-clear');

  const updateBar = () => {
    const count = selectedFlavors.size;
    if (!bar || !countEl || !textEl || !sendLink) return;

    bar.hidden = count === 0;
    countEl.textContent = String(count);
    textEl.textContent = count === 1 ? 'sabor para degustación' : 'sabores para degustación';

    const list = [...selectedFlavors].map((s) => `• ${s}`).join('\n');
    const msg = `Hola Monteville, deseo solicitar una degustación para mi establecimiento con estos sabores:\n${list}`;
    sendLink.href = `https://wa.me/51986698900?text=${encodeURIComponent(msg)}`;
  };

  pickBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.selectFlavor;
      if (!name) return;

      const label = btn.querySelector('[data-pick-label]');
      if (selectedFlavors.has(name)) {
        selectedFlavors.delete(name);
        btn.setAttribute('aria-pressed', 'false');
        if (label) label.textContent = 'Probar en cata';
      } else {
        selectedFlavors.add(name);
        btn.setAttribute('aria-pressed', 'true');
        if (label) label.textContent = 'Seleccionado';
      }
      updateBar();
    });
  });

  clearBtn?.addEventListener('click', () => {
    selectedFlavors.clear();
    pickBtns.forEach((btn) => {
      btn.setAttribute('aria-pressed', 'false');
      const label = btn.querySelector('[data-pick-label]');
      if (label) label.textContent = 'Probar en cata';
    });
    updateBar();
  });
</script>