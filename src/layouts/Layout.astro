---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogoSymbol from '../components/LogoSymbol.astro';
import { ogImage } from '../data/imagenes';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  header?: boolean;
}

const { title, description, noindex = false, header = true } = Astro.props;

// Aseguramos que la URL canónica siempre apunte a tu dominio
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://monteville.org.pe');

// Forzamos la URL exacta de tu foto de portada para WhatsApp/Facebook
const ogUrl = 'https://monteville.org.pe/og-image.jpg';

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#131209" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="es-PE" href={canonical} />
          <link rel="alternate" hreflang="x-default" href={canonical} />
        </>
      )
    }

    <!-- Meta Etiquetas para WhatsApp, Facebook, LinkedIn (Open Graph) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Monteville" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Alta heladería artesanal exclusiva para hoteles, restaurantes y cafeterías. Contribuimos con tu Éxito."} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:secure_url" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Monteville - Helados Gourmet" />
    
    <!-- Meta Etiquetas para Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content="Monteville - Helados Gourmet" />

    <Font cssVariable="--font-hina" preload />
    <Font cssVariable="--font-zen" preload />

    <slot name="head" />
  </head>
  <body class="min-h-svh overflow-x-clip">
    <LogoSymbol />
    {header && <Header />}
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    
    <!-- Botón Flotante Volver Arriba (Minimalista y Translúcido) -->
    <button 
      id="btn-back-to-top" 
      class="fixed bottom-6 right-6 z-[100] flex size-12 items-center justify-center rounded-full bg-bg/60 text-crema ring-1 ring-crema/20 backdrop-blur-md shadow-lg opacity-0 translate-y-8 transition-all duration-500 pointer-events-none hover:bg-teja hover:text-bg hover:ring-teja hover:-translate-y-1 focus:outline-none md:bottom-8 md:right-8" 
      aria-label="Volver arriba"
    >
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
      </svg>
    </button>

    <script>
      import '../scripts/motion';
      
      // Lógica para el botón de "Volver Arriba"
      document.addEventListener('DOMContentLoaded', () => {
        const btnTop = document.getElementById('btn-back-to-top');
        
        window.addEventListener('scroll', () => {
          if (window.scrollY > 300) {
            btnTop?.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
            btnTop?.classList.add('opacity-100', 'translate-y-0', 'cursor-pointer');
          } else {
            btnTop?.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
            btnTop?.classList.remove('opacity-100', 'translate-y-0', 'cursor-pointer');
          }
        });

        btnTop?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    </script>
  </body>
</html>